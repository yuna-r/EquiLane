  "semantics": {
    "floating_point": "Two separate FP32 FMA partial sums; RNE; input FP32 DAZ and output FTZ; combine partial sums before adding the original destination. BF16 expands by bits<<16; FP16 subnormals are retained on widening.",
    "native_intel_reference": "unsupported until actual CPU and OS execution is available; portable execution is never native reference evidence",
    "memory_faults": "Malformed or out-of-bounds records are rejected atomically; architectural page-fault delivery is outside the input contract.",
    "typed_tile_arguments": "__tile1024i operands are normalized to explicit selectors and configured shapes in the eight-tile state."
  }
}
